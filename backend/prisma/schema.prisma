generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?   @map("password_hash")
  city         String?
  birthDate    DateTime? @map("birth_date")
  gender       String?
  canHost      Boolean   @default(false) @map("can_host")
  isAdmin      Boolean   @default(false) @map("is_admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // Relations
  ownedRooms  Room[]       @relation("RoomOwner")
  loginEvents LoginEvent[]

  @@map("users")
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  method    String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_events")
}

model Room {
  id             String   @id @default(uuid())
  code           String   @unique
  ownerId        String   @map("owner_id")
  tvPasswordHash String   @map("tv_password_hash")
  uniqueVisitors Int      @default(0) @map("unique_visitors")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  owner User @relation("RoomOwner", fields: [ownerId], references: [id])

  @@map("rooms")
}

model Song {
  id           String    @id @default(uuid())
  videoId      String    @unique @map("video_id")
  title        String
  addedBy      String    @map("added_by")
  playCount    Int       @default(0) @map("play_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastPlayedAt DateTime? @map("last_played_at")

  playlists PlaylistSong[]

  @@map("songs")
}

model ScoreBackground {
  id        String   @id @default(uuid())
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("score_backgrounds")
}

model ScorePhrase {
  id        String   @id @default(uuid())
  phrase    String
  minScore  Int      @default(0) @map("min_score")
  maxScore  Int      @default(100) @map("max_score")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("score_phrases")
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?  @map("image_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  songs PlaylistSong[]

  @@map("playlists")
}

model PlaylistSong {
  playlistId String @map("playlist_id")
  songId     String @map("song_id")
  order      Int    @default(0)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@map("playlist_songs")
}

model BlockedChannel {
  id        String   @id @default(uuid())
  channelId String   @unique @map("channel_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_channels")
}

model SearchCache {
  id        String   @id @default(uuid())
  query     String   @unique
  results   Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([query])
  @@map("search_cache")
}
